{
  "name": "smart-recruitment-web",
  "productName": "Smart Recruitment",
  "description": "Smart Recruitment desktop client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android:sync": "capacitor sync android",
    "desktop:package": "npm run build && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.smartrecruitment.desktop",
    "productName": "Smart Recruitment",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Smart-Recruitment-Desktop-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "dompurify": "^3.4.18",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "undici": "8.10.0"
  }
}

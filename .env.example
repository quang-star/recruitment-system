# Copy to .env for local development and replace every placeholder.
POSTGRES_ADMIN_PASSWORD=replace-me
AUTH_DB_PASSWORD=replace-me
CORE_DB_PASSWORD=replace-me
AI_DB_PASSWORD=replace-me
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
POSTGRES_VOLUME_NAME=smart-recruitment-postgres-v2

AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWKS_URI=http://auth-service:8081/.well-known/jwks.json
AUTH_JWT_AUDIENCE=smart-recruitment-api
AUTH_JWT_PRIVATE_KEY_FILE=./.local/secrets/auth-jwt-private.pem
AUTH_JWT_PUBLIC_KEY_FILE=./.local/secrets/auth-jwt-public.pem
AUTH_SMTP_HOST=localhost
AUTH_SMTP_PORT=1025
AUTH_EMAIL_FROM=no-reply@smart-recruitment.local
AUTH_EMAIL_VERIFICATION_BASE_URL=http://localhost:5173/verify-email
AUTH_EMAIL_PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
CORE_EMAIL_FROM=no-reply@smart-recruitment.local
CORE_EMAIL_COMPANY_INVITATION_BASE_URL=http://localhost:5173/accept-invitation
AI_OCR_ENABLED=true
AI_OCR_MAX_PAGES=5
AI_OCR_TIMEOUT_SECONDS=60

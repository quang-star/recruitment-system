{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-recruitment.local/contracts/events/matching-completed-v1.schema.json",
  "title": "matching.completed.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applicationId",
    "cvVersionId",
    "jobVersionId",
    "matchingResultId",
    "status",
    "finalScore",
    "algorithmVersion",
    "taxonomyVersion"
  ],
  "properties": {
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "cvVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "jobVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "matchingResultId": {
      "type": "string",
      "format": "uuid"
    },
    "resultGeneration": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "supersedesMatchingResultId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "DEGRADED",
        "INSUFFICIENT_DATA"
      ]
    },
    "finalScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "qualityFlags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "algorithmVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "taxonomyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "inputRevisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cv": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "jd": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "asOfMonth": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "taxonomyVersions": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "cv": {
              "type": "string",
              "maxLength": 16
            },
            "jd": {
              "type": "string",
              "maxLength": 16
            }
          }
        }
      }
    }
  }
}

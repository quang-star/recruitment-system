{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-recruitment.local/contracts/events/job-confirmed-v1.schema.json",
  "title": "job.confirmed.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "jobVersionId", "parsedRevisionId", "sourceHash", "confirmedBy"],
  "properties": {
    "jobId": { "type": "string", "format": "uuid" },
    "jobVersionId": { "type": "string", "format": "uuid" },
    "parsedRevisionId": { "type": "string", "format": "uuid" },
    "sourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "confirmedBy": { "type": "string", "format": "uuid" }
  }
}

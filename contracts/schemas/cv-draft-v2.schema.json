{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-recruitment.local/contracts/schemas/cv-draft-v2.schema.json",
  "title": "CV authoring draft response v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draftId",
    "candidateUserId",
    "title",
    "templateId",
    "accentColor",
    "sectionOrder",
    "payload",
    "createdAt",
    "updatedAt",
    "version"
  ],
  "properties": {
    "draftId": {
      "$ref": "#/$defs/bigintId"
    },
    "candidateUserId": {
      "$ref": "#/$defs/bigintId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "templateId": {
      "enum": [
        "classic",
        "modern",
        "minimal",
        "executive"
      ]
    },
    "accentColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "sectionOrder": {
      "type": "array",
      "minItems": 7,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "introduction",
          "skills",
          "experiences",
          "education",
          "projects",
          "certificates",
          "languages",
          "awards",
          "activities",
          "hobbies"
        ]
      }
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "bigintId": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "maxLength": 19
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "subtitle",
        "startMonth",
        "endMonth",
        "current",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 240
        },
        "subtitle": {
          "type": "string",
          "maxLength": 240
        },
        "startMonth": {
          "type": "string",
          "pattern": "^(?:|(?!0000)\\d{4}-(?:0[1-9]|1[0-2]))$",
          "maxLength": 7
        },
        "endMonth": {
          "type": "string",
          "pattern": "^(?:|(?!0000)\\d{4}-(?:0[1-9]|1[0-2]))$",
          "maxLength": 7
        },
        "current": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 8000
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullName",
        "headline",
        "email",
        "phone",
        "location",
        "links",
        "introduction",
        "skills",
        "experiences",
        "education",
        "projects",
        "certificates",
        "languages"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "maxLength": 200
        },
        "headline": {
          "type": "string",
          "maxLength": 240
        },
        "email": {
          "type": "string",
          "maxLength": 320
        },
        "phone": {
          "type": "string",
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "maxLength": 240
        },
        "links": {
          "type": "string",
          "maxLength": 2000
        },
        "introduction": {
          "type": "string",
          "maxLength": 6000
        },
        "skills": {
          "type": "string",
          "maxLength": 4000
        },
        "experiences": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "education": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "projects": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "certificates": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "languages": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "photoDataUrl": {
          "type": "string",
          "maxLength": 160000,
          "pattern": "^(?:|data:image/(?:png|jpeg|webp);base64,[A-Za-z0-9+/=]+)$"
        },
        "language": {
          "enum": [
            "vi",
            "en"
          ]
        },
        "fontSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "lineSpacing": {
          "enum": [
            "compact",
            "normal",
            "relaxed"
          ]
        },
        "fontFamily": {
          "enum": [
            "sans",
            "serif",
            "mono"
          ]
        },
        "dateOfBirth": {
          "type": "string",
          "maxLength": 40
        },
        "gender": {
          "type": "string",
          "maxLength": 40
        },
        "awards": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "activities": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "hobbies": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "sectionTitles": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "introduction",
              "skills",
              "experiences",
              "education",
              "projects",
              "certificates",
              "languages",
              "awards",
              "activities",
              "hobbies"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 80
          }
        },
        "hiddenSections": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "introduction",
              "skills",
              "experiences",
              "education",
              "projects",
              "certificates",
              "languages",
              "awards",
              "activities",
              "hobbies"
            ]
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-recruitment.local/contracts/schemas/parsed-jd-v2.schema.json",
  "title": "ParsedJD v2",
  "description": "Structured job description whose hard constraints require recruiter confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document",
    "title",
    "requirements",
    "responsibilities",
    "overallConfidence",
    "qualityFlags"
  ],
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "page",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "$schema": {
      "const": "https://smart-recruitment.local/contracts/schemas/parsed-jd-v2.schema.json"
    },
    "schemaVersion": {
      "const": "parsed-jd/2.0"
    },
    "document": {
      "$ref": "#/$defs/document"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "overallConfidence": {
      "$ref": "#/$defs/confidence"
    },
    "qualityFlags": {
      "$ref": "#/$defs/qualityFlags"
    }
  },
  "$defs": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "qualityFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,99}$"
      },
      "uniqueItems": true
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobVersionId",
        "language",
        "sourceHash",
        "parserVersion"
      ],
      "properties": {
        "jobVersionId": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
          "maxLength": 19
        },
        "language": {
          "enum": [
            "vi",
            "en",
            "mixed",
            "unknown"
          ]
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parserVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "taxonomyVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "maxLength": 16
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "canonicalFamily",
        "level",
        "confidence",
        "evidenceIds"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "canonicalFamily": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "BACKEND",
            "FRONTEND",
            "FULLSTACK",
            "MOBILE",
            "DEVOPS",
            "DATA_AI",
            "QA",
            "SECURITY",
            "OTHER",
            null
          ]
        },
        "level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "INTERN",
            "FRESHER",
            "JUNIOR",
            "MIDDLE",
            "SENIOR",
            "LEAD",
            "MANAGER",
            null
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredSkills",
        "preferredSkills",
        "minimumRelevantExperienceMonths",
        "education",
        "languages"
      ],
      "properties": {
        "requiredSkills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillRequirement"
          }
        },
        "preferredSkills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillRequirement"
          }
        },
        "minimumRelevantExperienceMonths": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "education": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    },
    "skillRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "canonicalSkillId",
        "normalizationStatus",
        "criticality",
        "minimumMonths",
        "evidenceIds",
        "confidence",
        "confirmedByRecruiter"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "canonicalSkillId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
          "maxLength": 19
        },
        "normalizationStatus": {
          "enum": [
            "KNOWN",
            "PENDING",
            "UNRESOLVED"
          ]
        },
        "criticality": {
          "enum": [
            "CRITICAL",
            "NORMAL"
          ]
        },
        "minimumMonths": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "confirmedByRecruiter": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "normalizationStatus": {
                "const": "KNOWN"
              }
            },
            "required": [
              "normalizationStatus"
            ]
          },
          "then": {
            "properties": {
              "canonicalSkillId": {
                "type": "string",
                "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
                "maxLength": 19
              }
            }
          },
          "else": {
            "properties": {
              "canonicalSkillId": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "normalizedValue",
        "required",
        "evidenceIds",
        "confidence",
        "confirmedByRecruiter"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "normalizedValue": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "required": {
          "type": "boolean"
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "confirmedByRecruiter": {
          "type": "boolean"
        }
      }
    }
  }
}

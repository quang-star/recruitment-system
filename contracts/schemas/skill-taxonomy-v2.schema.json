{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-recruitment.local/contracts/schemas/skill-taxonomy-v2.schema.json",
  "title": "IT skill taxonomy v2",
  "description": "Versioned canonical IT skills, aliases and explicit inter-skill relations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "semanticVersion",
    "status",
    "languageScope",
    "skills"
  ],
  "properties": {
    "$schema": {
      "const": "https://smart-recruitment.local/contracts/schemas/skill-taxonomy-v2.schema.json"
    },
    "schemaVersion": {
      "const": "skill-taxonomy/2.0"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "RETIRED"
      ]
    },
    "languageScope": {
      "type": "array",
      "items": {
        "enum": [
          "vi",
          "en"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableId",
        "canonicalName",
        "normalizedName",
        "type",
        "category",
        "aliases",
        "relations",
        "status"
      ],
      "properties": {
        "stableId": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
          "maxLength": 19
        },
        "canonicalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "normalizedName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.+#/-][a-z0-9]+|[.+#])*$",
          "maxLength": 160
        },
        "type": {
          "enum": [
            "language",
            "framework",
            "library",
            "database",
            "cloud",
            "devops",
            "testing",
            "data_ai",
            "security",
            "methodology",
            "soft_skill",
            "other"
          ]
        },
        "category": {
          "enum": [
            "backend",
            "frontend",
            "fullstack",
            "mobile",
            "devops",
            "data_ai",
            "qa",
            "security",
            "cross_functional"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "status": {
          "enum": [
            "ACTIVE",
            "DEPRECATED"
          ]
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "normalized",
        "language"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "normalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "language": {
          "enum": [
            "vi",
            "en",
            "neutral"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "targetSkillId"
      ],
      "properties": {
        "type": {
          "enum": [
            "BROADER",
            "NARROWER",
            "RELATED",
            "SUPERSEDES"
          ]
        },
        "targetSkillId": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
          "maxLength": 19
        }
      }
    }
  }
}

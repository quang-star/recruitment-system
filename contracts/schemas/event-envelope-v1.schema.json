{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://smart-recruitment.local/contracts/event-envelope-v1.schema.json","title":"Event envelope v1","type":"object","additionalProperties":false,"required":["eventId","eventType","schemaVersion","correlationId","idempotencyKey","occurredAt","payload"],"properties":{"eventId":{"type":"string","format":"uuid"},"eventType":{"type":"string","pattern":"^[a-z][a-z0-9.-]+\\.v[1-9][0-9]*$"},"schemaVersion":{"type":"integer","minimum":1},"correlationId":{"type":"string","format":"uuid"},"causationId":{"type":["string","null"],"format":"uuid"},"idempotencyKey":{"type":"string","minLength":1,"maxLength":200},"occurredAt":{"type":"string","format":"date-time"},"payload":{"type":"object"}}}

# Raw datasets and local working artifacts are not versioned.
/data/
/evaluation/*
!/evaluation/matching-annotation-template.csv
/local-reference/
/.local/
/.qa/
# Only the two root project guides are public; keep other documents local.
/docs/
**/*.md
!/README.md
!/ARCHITECTURE.md
*.partial

# Codex harness stays local.
/AGENTS.md
/CODEX.md
/.agents/PLANS.md
/.agents/plans/
/scripts/codex-check.ps1

# Derived build and editor artifacts.
**/build/
**/target/
**/node_modules/
**/dist/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/pytest-cache-files-*/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/.coverage/
**/coverage/
**/playwright-report/
**/test-results/
coverage.xml
.coverage
*.pyc
*.log
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db
.idea/
*.tsbuildinfo
.vscode/

# Local secrets must never be committed.
.env
.env.*
!.env.example
